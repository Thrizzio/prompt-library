# Supabase Configuration
# Replace with your project URL and anonymous publishable API key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Single-User Owner Passkey (used to unlock creating, editing, and deleting prompts)
VITE_ADMIN_PASSKEY=your-secure-admin-passkey
